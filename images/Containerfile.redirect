# syntax=docker/dockerfile:1.7

# ---------- Stage 1: builder ----------
#
# Builds the `redirect` binary in the `cloud` crate. The Cloud Run
# service answers standalone host redirects (see `cloud/src/redirect.rs`
# for the current dispatch table) and ships no templates / assets / DB —
# distroless/static is enough.
#
# Same single-COPY-then-build layout as Containerfile.workflows-service
# so the build context is identical and `docker buildx` caches stay
# warm across the images.

FROM rust:1.99-bookworm AS builder

RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# `rust-toolchain.toml` must land BEFORE `rustup target add`: the override
# pins a specific 1.98.0 toolchain that rustup re-syncs the first time cargo
# runs in this dir. Adding the target beforehand (against the base image's
# default toolchain) leaves the re-synced toolchain without the musl std,
# and `cargo build --target …-musl` then fails with `can't find crate for
# std`. Adding it here attaches the target to the toolchain the build uses.
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN rustup target add x86_64-unknown-linux-musl
COPY rules             rules
COPY project-scaffold project-scaffold
COPY skills            skills
COPY store             store
COPY repos             repos
COPY cli               cli
COPY LICENSE        LICENSE
COPY LICENSE-MIT    LICENSE-MIT
COPY LICENSE-APACHE-2 LICENSE-APACHE-2
COPY NOTICE         NOTICE
COPY THIRD-PARTY-NOTICES.txt THIRD-PARTY-NOTICES.txt
COPY portal            portal
COPY server            server
COPY neon              neon
COPY webapp            webapp
COPY views             views
COPY telemetry         telemetry
COPY README.md         README.md
COPY workflows         workflows
COPY workflows-service workflows-service
COPY word              word
COPY cloud             cloud
COPY mcp               mcp
COPY features          features
COPY forms             forms
COPY lsp               lsp
COPY live-inquiry      live-inquiry
COPY pdf               pdf
COPY templates templates
COPY archives          archives
COPY import            import
COPY billing           billing
COPY billing-workflows billing-workflows
COPY gateway gateway
COPY sandbox-skills sandbox-skills
# The `views` crate bakes in `docs/lsp/*.md` via include_str! of paths that
# live outside its crate dir. `-p cloud` does not compile `views` today, but
# the whole workspace is staged here (see the resolve-time note above), so
# `docs` is staged alongside `views` to keep the build context self-consistent
# if a future dependency edge pulls `views` into this image.
COPY docs              docs
# Likewise `project-scaffold` embeds `.agents/skills/*/SKILL.md`; `cloud`
# reaches it only through a dev-dependency today, but the lockfile guard in
# cli/tests/containerfile_docs_copy.rs cannot tell, so stage it here too.
COPY .agents           .agents

RUN cargo build --release --target x86_64-unknown-linux-musl -p cloud --bin redirect

# ---------- Stage 2: runtime ----------

FROM gcr.io/distroless/static:nonroot AS runtime

WORKDIR /app

COPY --from=builder /src/target/x86_64-unknown-linux-musl/release/redirect /app/redirect

ENV RUST_LOG=info

# An image someone pulled is a copy, and its holder has neither the repository
# nor a release archive. Stage the project's license and attribution files
# beside the binary so downstream recipients can retain them in distributions.
LABEL org.opencontainers.image.licenses="MIT OR Apache-2.0" \
      org.opencontainers.image.vendor="Guieb & Shook PC" \
      org.opencontainers.image.source="https://github.com/neon-law/navigator"

COPY LICENSE /app/LICENSE
COPY LICENSE-MIT /app/LICENSE-MIT
COPY LICENSE-APACHE-2 /app/LICENSE-APACHE-2
COPY NOTICE  /app/NOTICE

USER nonroot:nonroot

# Cloud Run injects PORT (8080 today); the binary honors it. We
# don't EXPOSE since Cloud Run ignores it.
ENTRYPOINT ["/app/redirect"]
