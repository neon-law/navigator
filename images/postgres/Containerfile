# scripts/postgres-image-bump.sh rewrites these pins every week to the newest
# PostgreSQL minor, Apache AGE, and pgvector releases for PG_MAJOR. A major
# upgrade is a data migration, so PG_MAJOR changes only by hand.
ARG PG_MAJOR=16
ARG PG_VERSION=16.16
ARG PG_DIGEST=sha256:a49f7438ba03589f9b1ca062f2da82e899b48ea1dc50d2449fa09a70be83ebca
ARG AGE_VERSION=1.6.0
ARG AGE_SHA512=1e0a434d53d669e5d067721e1eba8c3c3c2ae072709d5f90783beeba6f5e88f592fa5d8808d621b720c22edfe8c698baa9b0adb9c7b4e3e2a83e7a753bd795c8
ARG PGVECTOR_VERSION=0.8.7
ARG POSTGIS_PACKAGE_VERSION=3.6.4+dfsg-2.pgdg12+1
ARG PGVECTOR_SHA256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85

FROM postgres:${PG_VERSION}-bookworm@${PG_DIGEST} AS build
ARG PG_MAJOR
ARG AGE_VERSION
ARG AGE_SHA512
ARG PGVECTOR_VERSION
ARG PGVECTOR_SHA256
# Build the extensions with the exact server package from the shared base.
RUN pg_package_version="$(dpkg-query -W -f='${Version}' "postgresql-${PG_MAJOR}")" \
 && apt-get update \
 && apt-get install -y --no-install-recommends build-essential curl ca-certificates flex bison \
      "postgresql-${PG_MAJOR}=${pg_package_version}" "postgresql-server-dev-${PG_MAJOR}=${pg_package_version}" \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# downloads.apache.org is the primary dist server (CDN-backed); the
# archive.apache.org mirror has been unreachable from CI runners, and the
# sha512 below still pins the content either way.
RUN curl -fLsS https://downloads.apache.org/age/PG${PG_MAJOR}/${AGE_VERSION}/apache-age-${AGE_VERSION}-src.tar.gz -o age.tar.gz \
 && echo "${AGE_SHA512}  age.tar.gz" | sha512sum -c - \
 && mkdir age && tar xzf age.tar.gz -C age --strip-components=1 \
 && make -C age PG_CONFIG=/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config -j2 \
 && make -C age PG_CONFIG=/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config DESTDIR=/out install
# codeload serves the tag tarball directly; the github.com archive URL
# redirects to objects.githubusercontent, whose runner-egress 504s have
# repeatedly broken CI fetches. The sha256 pin still verifies the content.
RUN curl -fLsS --retry 5 --retry-delay 10 --retry-all-errors --connect-timeout 30 https://codeload.github.com/pgvector/pgvector/tar.gz/refs/tags/v${PGVECTOR_VERSION} -o vector.tar.gz \
 && echo "${PGVECTOR_SHA256}  vector.tar.gz" | sha256sum -c - \
 && mkdir vector && tar xzf vector.tar.gz -C vector --strip-components=1 \
 && make -C vector PG_CONFIG=/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config OPTFLAGS='' -j2 \
 && make -C vector PG_CONFIG=/usr/lib/postgresql/${PG_MAJOR}/bin/pg_config DESTDIR=/out install

FROM postgres:${PG_VERSION}-bookworm@${PG_DIGEST}
ARG PG_MAJOR
ARG PG_VERSION
ARG AGE_VERSION
ARG PGVECTOR_VERSION
ARG POSTGIS_PACKAGE_VERSION
LABEL org.opencontainers.image.source="https://github.com/neon-law/navigator"
LABEL org.opencontainers.image.description="PostgreSQL ${PG_VERSION} with Apache AGE ${AGE_VERSION} and pgvector ${PGVECTOR_VERSION}, PostGIS ${POSTGIS_PACKAGE_VERSION}, rebuilt weekly with Debian security updates"
LABEL org.opencontainers.image.licenses="Apache-2.0"
# The weekly rebuild exists for this layer: the base digest is pinned, so
# only an upgrade here carries Debian security fixes into a new image. The
# PostgreSQL packages are held so the server stays at the pinned minor.
RUN apt-mark hold $(dpkg-query -W -f '${db:Status-Abbrev}${Package}\n' 'postgresql*' 'libpq*' | sed -n 's/^ii *//p') \
 && sed -e 's/^deb /deb-src /' -e 's/ main .*/ main/' \
      /etc/apt/sources.list.d/pgdg.list > /etc/apt/sources.list.d/postgis-source.list \
 && apt-get update && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      "postgresql-${PG_MAJOR}-postgis-3=${POSTGIS_PACKAGE_VERSION}" \
      "postgresql-${PG_MAJOR}-postgis-3-scripts=${POSTGIS_PACKAGE_VERSION}" \
 && mkdir -p /usr/share/source/postgis \
 && (cd /usr/share/source/postgis && apt-get source --download-only "postgis=${POSTGIS_PACKAGE_VERSION}") \
 && rm /etc/apt/sources.list.d/postgis-source.list \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /
COPY --from=build /src/age/LICENSE /src/age/NOTICE /usr/share/doc/apache-age/
COPY --from=build /src/vector/LICENSE /usr/share/doc/pgvector/LICENSE
COPY LICENSE NOTICE /usr/share/doc/navigator-postgres/
